    "# مثال ۳: بازی حدس عدد\n",
    "import random\n",
    "\n",
    "secret_number = random.randint(1, 100)\n",
    "attempts = 0\n",
    "max_attempts = 7\n",
    "\n",
    "print(\"🎮 بازی حدس عدد من!\")\n",
    "print(f\"من یک عدد بین ۱ تا ۱۰۰ انتخاب کردم. {max_attempts} فرصت داری!\")\n",
    "print(\"-\" * 45)\n",
    "\n",
    "while attempts < max_attempts:\n",
    "    attempts += 1\n",
    "    remaining = max_attempts - attempts + 1\n",
    "    \n",
    "    try:\n",
    "        guess = int(input(f\"حدس شماره {attempts} (باقیمانده: {remaining}): \"))\n",
    "        \n",
    "        if guess < secret_number:\n",
    "            print(\"📈 برو بالاتر!\")\n",
    "        elif guess > secret_number:\n",
    "            print(\"📉 برو پایین‌تر!\")\n",
    "        else:\n",
    "            print(f\"🎉 آفرین! تو در {attempts} بار حدس زدی!\")\n",
    "            print(f\"🎯 عدد صحیح: {secret_number}\")\n",
    "            break\n",
    "            \n",
    "    except ValueError:\n",
    "        print(\"❌ لطفاً فقط عدد وارد کن!\")\n",
    "        attempts -= 1  # فرصت از دست نره\n",
    "else:\n",
    "    print(f\"\\n😔 متأسفم! فرصت‌ت تموم شد.\")\n",
    "    print(f\"🎯 عدد صحیح این بود: {secret_number}\")\n",
    "    print(\"🔁 دفعه بعد موفق می‌شی!\")"
   ]
