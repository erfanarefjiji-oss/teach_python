    "# مثال ۱: چاپ اعداد ۱ تا ۱۰\n",
    "print(\"🔢 اعداد ۱ تا ۱۰:\")\n",
    "for i in range(1, 11):\n",
    "    print(f\"عدد {i}\")"
   ]
