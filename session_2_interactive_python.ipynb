  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# مثال ۳: محاسبه مجموع اعداد\n",
    "print(\"🧮 برنامه محاسبه مجموع اعداد\")\n",
    "n = int(input(\"تا چه عددی جمع کنیم؟ \"))\n",
    "\n",
    "sum_numbers = 0\n",
    "print(f\"\\n🔢 مجموع اعداد از ۱ تا {n}:\")\n",
    "\n",
    "for i in range(1, n + 1):\n",
    "    sum_numbers += i\n",
    "    print(f\"مجموع تا {i}: {sum_numbers}\")\n",
    "\n",
    "print(f\"\\n📌 نتیجه نهایی: مجموع اعداد از ۱ تا {n} برابر است با {sum_numbers}\")\n",
    "\n",
    "# فرمول ریاضی: مجموع اعداد از ۱ تا n = n × (n + 1) / 2\n",
    "formula_result = n * (n + 1) / 2\n",
    "print(f\"✅ بررسی با فرمول ریاضی: {formula_result}\")"
   ]
