    "# 🧮 پروژه کامل: ماشین حساب هوشمند\n",
    "import time\n",
    "\n",
    "def calculator():\n",
    "    print(\"🧮 ماشین حساب هوشمند پایتون 🐍\")\n",
    "    print(\"=\" * 40)\n",
    "    \n",
    "    while True:\n",
    "        print(\"\\n📋 منوی اصلی:\")\n",
    "        print(\"1. ➕ جمع\")\n",
    "        print(\"2. ➖ تفریق\")\n",
    "        print(\"3. ✖️ ضرب\")\n",
    "        print(\"4. ➗ تقسیم\")\n",
    "        print(\"5. 🧮 محاسبه میانگین چند عدد\")\n",
    "        print(\"6. ❌ خروج\")\n",
    "        \n",
    "        choice = input(\"\\nانتخاب شما (1-6): \")\n",
    "        \n",
    "        if choice == \"6\":\n",
    "            print(\"\\n👋 خدانگهدار! ممنون از استفاده\")\n",
    "            break\n",
    "            \n",
    "        if choice in [\"1\", \"2\", \"3\", \"4\"]:\n",
    "            # عملیات اصلی\n",
    "            try:\n",
    "                num1 = float(input(\"عدد اول: \"))\n",
    "                num2 = float(input(\"عدد دوم: \"))\n",
    "                \n",
    "                if choice == \"1\":\n",
    "                    result = num1 + num2\n",
    "                    operation = \"+\"\n",
    "                elif choice == \"2\":\n",
    "                    result = num1 - num2\n",
    "                    operation = \"-\"\n",
    "                elif choice == \"3\":\n",
    "                    result = num1 * num2\n",
    "                    operation = \"×\"\n",
    "                elif choice == \"4\":\n",
    "                    if num2 == 0:\n",
    "                        print(\"❌ خطا: تقسیم بر صفر ممکن نیست!\")\n",
    "                        continue\n",
    "                    result = num1 / num2\n",
    "                    operation = \"÷\"\n",
    "                \n",
    "                print(f\"\\n🧮 نتیجه: {num1} {operation} {num2} = {result}\")\n",
    "                print(f\"📊 به صورت اعشاری: {result:.4f}\")\n",
    "                \n",
    "            except ValueError:\n",
    "                print(\"❌ خطا: لطفاً فقط عدد وارد کنید!\")\n",
    "                \n",
    "        elif choice == \"5\":\n",
    "            # محاسبه میانگین\n",
    "            print(\"\\n📊 محاسبه میانگین (برای پایان، 'END' را وارد کنید)\")\n",
    "            numbers = []\n",
    "            \n",
    "            while True:\n",
    "                user_input = input(f\"عدد {len(numbers) + 1} (یا END برای پایان): \")\n",
    "                \n",
    "                if user_input.upper() == \"END\":\n",
    "                    break\n",
    "                    \n",
    "                try:\n",
    "                    number = float(user_input)\n",
    "                    numbers.append(number)\n",
    "                    print(f\"✅ اضافه شد: {number}\")\n",
    "                except ValueError:\n",
    "                    print(\"❌ لطفاً عدد معتبر وارد کنید!\")\n",
    "            \n",
    "            if numbers:\n",
    "                average = sum(numbers) / len(numbers)\n",
    "                print(f\"\\n📈 نتایج:\")\n",
    "                print(f\"📊 اعداد: {numbers}\")\n",
    "                print(f\"🔢 تعداد: {len(numbers)}\")\n",
    "                print(f\"📊 مجموع: {sum(numbers)}\")\n",
    "                print(f\"📈 میانگین: {average:.2f}\")\n",
