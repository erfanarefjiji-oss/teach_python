    "### حلقه `while` - تا وقتی شرط درسته ادامه بده"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# مثال ۱: شمارش معکوس\n",
    "print(\"🚀 شمارش معکوس برای پرتاب موشک!\")\n",
    "countdown = 10\n",
    "\n",
    "while countdown > 0:\n",
    "    print(f\"🔢 {countdown}...\")\n",
    "    countdown -= 1  # countdown = countdown - 1\n",
    "\n",
    "print(\"🎆 پرتاب موشک! انفجار! 💥\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# مثال ۲: جمع اعداد تا زمانی که کاربر صفر وارد نکنه\n",
    "print(\"🧮 برنامه جمع اعداد (برای خروج ۰ را وارد کنید)\")\n",
    "print(\"-\" * 40)\n",
    "\n",
    "total = 0\n",
    "count = 0\n",
    "\n",
    "while True:\n",
    "    user_input = input(f\"عدد شماره {count + 1} را وارد کنید (یا ۰ برای پایان): \")\n",
    "    \n",
    "    if user_input == \"0\":\n",
    "        break  # خروج از حلقه\n",
    "    \n",
    "    number = float(user_input)\n",
    "    total += number\n",
    "    count += 1\n",
    "    print(f\"مجموع فعلی: {total}\")\n",
    "\n",
    "print(f\"\\n🎯 مجموع نهایی: {total}\")\n",
    "print(f\"📊 تعداد اعداد وارد شده: {count}\")\n",
    "if count > 0:\n",
    "    print(f\"📈 میانگین اعداد: {total / count:.2f}\")"
   ]
