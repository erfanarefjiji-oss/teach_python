  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# مثال ۲: جدول ضرب\n",
    "number = int(input(\"برای جدول ضرب، یک عدد وارد کنید: \"))\n",
    "print(f\"\\n📋 جدول ضرب {number}:\")\n",
    "print(\"-\" * 20)\n",
    "\n",
    "for i in range(1, 11):\n",
    "    result = number * i\n",
    "    print(f\"{number} × {i} = {result}\")"
   ]
